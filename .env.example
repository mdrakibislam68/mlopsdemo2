# =================================================================
# Environment Configuration for End-to-End MLOps Lab
# Copy this file to .env and adjust variables if needed:
# cp .env.example .env
# =================================================================

# Base Project
PROJECT_NAME=mlops-lab-house-prices
ENVIRONMENT=development

# PostgreSQL (MLflow Backend Store)
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflowpassword
POSTGRES_DB=mlflow
POSTGRES_PORT=5432

# MinIO (S3-compatible Object Storage for DVC & MLflow Artifacts)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DVC_BUCKET=dvc-store
MINIO_MLFLOW_BUCKET=mlflow-artifacts

# AWS / S3 Credentials used by boto3 and DVC
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
MLFLOW_S3_ENDPOINT_URL=http://minio:9000

# MLflow Tracking Server
# Note: Port 5001 avoids conflict with macOS AirPlay receiver on port 5000
MLFLOW_PORT=5001
MLFLOW_TRACKING_URI=http://localhost:5001

# FastAPI Service
API_PORT=8000
MODEL_NAME=house-price-predictor

# Prometheus & Grafana Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

