# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/

# MLflow local tracking files & artifacts (when running locally outside Docker)
mlruns/
mlartifacts/
mlflow.db
mlflow.db-*
.mlflow/

# DVC local cache and temporary files (DVC tracks .dvc and dvc.yaml)
.dvc/cache/
.dvc/tmp/
.dvc/config.local

# Data files (tracked by DVC, not git)
data/raw/*.csv
data/processed/*.csv
data/processed/*.joblib
!data/raw/.gitkeep
!data/processed/.gitkeep

# Environment variables
.env
!.env.example

# IDEs and OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Pytest / Coverage
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# Docker volumes mount / local data dumps
minio_data/
postgres_data/
prometheus_data/
grafana_data/

